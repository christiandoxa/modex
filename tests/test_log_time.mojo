from std.testing import assert_equal
from std.os import setenv

from modex.log_time import local_log_timestamp


def main() raises:
    _ = setenv("TZ", "UTC", True)
    assert_equal(local_log_timestamp("2026-06-20T01:00:00Z"), "2026-06-20 01:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2026-06-20T01:00:00.12+02:00"), "2026-06-19 23:00:00.120 +00:00")
    assert_equal(local_log_timestamp("2026-06-20 01:00:00.123 +00:00"), "2026-06-20 01:00:00.123 +00:00")
    assert_equal(local_log_timestamp("2026-06-20 01:00:00 +02:00"), "2026-06-19 23:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2026-06-20 01:00:00.12 +02:00"), "2026-06-19 23:00:00.120 +00:00")
    assert_equal(local_log_timestamp("+10000-01-01 00:00:00 +00:00"), "+10000-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("-0001-01-01 00:00:00 +00:00"), "-0001-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-2-3 4:5:6 +0000"), "2024-02-03 04:05:06.000 +00:00")
    assert_equal(local_log_timestamp("2024-02-03 04:05:06\t  +00:00"), "2024-02-03 04:05:06.000 +00:00")
    assert_equal(local_log_timestamp("2024-02-03\n04:05:06\r+00:00"), "2024-02-03 04:05:06.000 +00:00")
    assert_equal(local_log_timestamp("2024-02-03 04:05:06.123456789123+00:00"), "2024-02-03 04:05:06.123 +00:00")
    assert_equal(local_log_timestamp("2024-02-03 04:05:06 +7:00"), "2024-02-03 04:05:06 +7:00")
    assert_equal(local_log_timestamp("2024-02-03 04:05:06 +00:00 "), "2024-02-03 04:05:06 +00:00 ")
    assert_equal(local_log_timestamp("10000-01-01 00:00:00 +00:00"), "10000-01-01 00:00:00 +00:00")
    assert_equal(local_log_timestamp("02026-01-01 00:00:00 +00:00"), "02026-01-01 00:00:00 +00:00")
    assert_equal(local_log_timestamp("1-1-1 0:0:0 +0000"), "0001-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("-1-1-1 0:0:0 +0000"), "-0001-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("+1-1-1 0:0:0 +0000"), "0001-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-0100:00:00+0000"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp(" 2024-01-01 00:00:00+0000"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-01 00:00:00Z"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-1-1 0:0:0Z"), "2024-1-1 0:0:0Z")
    assert_equal(local_log_timestamp("+00000002024-01-01 00:00:00+0000"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024- 1- 1  0: 0: 0 +0000"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-01 00:00:00 +00 :00"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-01 00:00:00 +00\u200300"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-01\u200300:00:00\u2003+00:00"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("\u20032024-01-01 00:00:00+0000"), "2024-01-01 00:00:00.000 +00:00")
    assert_equal(local_log_timestamp("2024-01-01T+1:02:03Z"), "2024-01-01T+1:02:03Z")
    assert_equal(local_log_timestamp("-001-01-01T00:00:00Z"), "-001-01-01T00:00:00Z")
    assert_equal(local_log_timestamp("2024-01-01T00:00:00++1:00"), "2024-01-01T00:00:00++1:00")
    assert_equal(local_log_timestamp("2026-06-20T01:00:60.999999999Z"), "2026-06-20 01:00:60.999 +00:00")
    _ = setenv("TZ", "Asia/Jakarta", True)
    assert_equal(local_log_timestamp("0000-01-01T00:00:00Z"), "0000-01-01 07:07:12.000 +07:07")
    assert_equal(local_log_timestamp("1900-01-01T00:00:60.123Z"), "1900-01-01 07:08:12.123 +07:07")
    _ = setenv("TZ", "America/New_York", True)
    assert_equal(local_log_timestamp("0000-01-01T00:00:00Z"), "-0001-12-31 19:03:58.000 -04:56")
    assert_equal(local_log_timestamp("0000-01-01T00:00:60Z"), "-0001-12-31 19:04:58.000 -04:56")
    _ = setenv("TZ", "XXX-0:00:30", True)
    assert_equal(local_log_timestamp("2024-01-01T00:00:00Z"), "2024-01-01 00:00:30.000 +00:01")
    assert_equal(local_log_timestamp("2024-01-01T00:00:60Z"), "2024-01-01 00:01:30.000 +00:01")
    _ = setenv("TZ", "XXX0:00:30", True)
    assert_equal(local_log_timestamp("2024-01-01T00:00:60Z"), "2024-01-01 00:00:30.000 -00:01")
    assert_equal(local_log_timestamp("-"), "-")
    assert_equal(local_log_timestamp("1712345678"), "1712345678")
    print("Log timestamp checks: PASS")
